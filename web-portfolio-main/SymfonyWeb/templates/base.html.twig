<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Welcome!{% endblock %}</title>
    
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <link href="https://bootswatch.com/5/litera/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    <style>
        :root {
            --site-font: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            --accent: #3b82f6;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: var(--site-font);
            color: #111827;
            -webkit-font-smoothing: antialiased;
        }

        .content {
            min-height: calc(100vh - 160px); /* Ajustement pour pousser le footer */
            padding-bottom: 40px;
        }

        footer.footer-custom {
            background-color: #343a40;
            color: white;
            padding: 30px 0 15px;
            box-shadow: 0 -4px 24px rgba(0,0,0,0.12);
        }

        .footer-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            padding: 0 20px;
        }

        .footer-col h4 { margin-bottom: 15px; font-size: 1.1rem; color: #fff; }
        .footer-link { color: #dbeafe; text-decoration: none; display: block; margin-bottom: 5px; }
        .footer-link:hover { text-decoration: underline; }
        
        .socials-icons { display: flex; gap: 10px; }
        .socials-icons a { 
            width: 35px; height: 35px; display: flex; align-items: center; 
            justify-content: center; border-radius: 8px; background: rgba(255,255,255,0.1); 
            color: white; text-decoration: none; transition: 0.3s;
        }
        .socials-icons a:hover { background: var(--accent); }

        .footer-bottom { 
            text-align: center; margin-top: 25px; padding-top: 15px; 
            border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.85rem; color: #bbb;
        }

        #back-to-top {
            position: fixed; right: 20px; bottom: 20px; width: 45px; height: 45px;
            border-radius: 50%; border: none; background: var(--accent); color: white;
            display: none; align-items: center; justify-content: center; cursor: pointer;
            z-index: 1000; transition: 0.3s;
        }

        .lang-switcher {
            display: flex; gap: 10px; margin-left: 15px;
        }
        .lang-link { font-size: 1.2rem; text-decoration: none; }

        @media (max-width: 768px) {
            .footer-inner { grid-template-columns: 1fr; text-align: center; }
            .socials-icons { justify-content: center; }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">{{ 'nav.home'|trans }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/cv">{{ 'nav.cv'|trans }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="/realisations">{{ 'nav.realisations'|trans }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="/loisirs">{{ 'nav.loisirs'|trans }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Contact">{{ 'nav.contact'|trans }}</a></li>
                </ul>
                
                {# Switcher de langue intelligent #}
                <div class="lang-switcher">
                    <a class="lang-link" href="{{ path(app.request.attributes.get('_route') ?: 'app_home', app.request.attributes.get('_route_params')|merge({'_locale': 'fr'})) }}" title="Français">🇫🇷</a>
                    <a class="lang-link" href="{{ path(app.request.attributes.get('_route') ?: 'app_home', app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}" title="English">🇬🇧</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="content">
        {% block body %}{% endblock %}
    </main>

    <footer class="footer-custom">
        <div class="footer-inner">
            <div class="footer-col">
                <h4>{{ 'footer.contact_title'|trans }}</h4>
                <a class="footer-link" href="mailto:bacotdimitri@gmail.com">bacotdimitri@gmail.com</a>
                <a class="footer-link" href="tel:+33750575987">07 50 57 59 87</a>
                <p class="mt-2 small">{{ 'footer.available'|trans({'%city%': 'Roanne'}) }}</p>
            </div>

            <div class="footer-col">
                <h4>{{ 'footer.socials_title'|trans }}</h4>
                <div class="socials-icons">
                    <a href="https://fr.linkedin.com/in/dimitri-bacot" target="_blank" rel="noopener"><i class="fab fa-linkedin-in"></i></a>
                    <a href="https://github.com/Dbacot" target="_blank" rel="noopener"><i class="fab fa-github"></i></a>
                    <a href="https://www.instagram.com/" target="_blank" rel="noopener"><i class="fab fa-instagram"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h4>{{ 'footer.about_title'|trans }}</h4>
                <p class="small mb-1">Dimitri Bacot — {{ 'footer.portfolio'|trans }}</p>
                <p class="small text-muted">© {{ "now"|date('Y') }} — {{ 'footer.rights'|trans }}</p>
            </div>
        </div>

        <div class="footer-bottom">
            {{ 'footer.bottom'|trans }}
        </div>
    </footer>

    <button id="back-to-top" title="Retour en haut">↑</button>

    <script>
        // Gestion du bouton retour en haut
        const btt = document.getElementById('back-to-top');
        window.addEventListener('scroll', () => {
            btt.style.display = window.scrollY > 300 ? 'flex' : 'none';
        });
        btt.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>
</body>
</html>